{
    "id": "rocky-9",
    "name": "Rocky Linux 9",
    "description": "Rocky Linux 9 from the official GenericCloud image, a stable enterprise-grade server OS binary-compatible with Red Hat Enterprise Linux and supported into 2032.",
    "icon": "_icons/rocky.svg",
    "website": "https://rockylinux.org/",
    "category": "server",
    "truenasVersion": ">=25.04.2.6",
    "provisioning": {
        "strategy": "cloud-init",
        "source": {
            "url": "https://dl.rockylinux.org/pub/rocky/9/images/x86_64/Rocky-9-GenericCloud-Base-{version}.x86_64.qcow2",
            "version": "9.9-20261112.0",
            "format": "qcow2",
            "compression": "none",
            "sha256": "4f88f4209de50813d8054ab97309e7169a580206a0c4ea04f375d36c4846d50e",
            "releasesUrl": "https://dl.rockylinux.org/pub/rocky/9/images/x86_64/"
        },
        "cloudInit": {
            "userDataTemplate": "linux-default"
        }
    },
    "resources": {
        "minMemoryMb": 2048,
        "recMemoryMb": 4096,
        "minVcpus": 1,
        "recVcpus": 2,
        "diskGb": 32
    },
    "guest": {
        "firmware": "UEFI",
        "diskBus": "VIRTIO",
        "nicModel": "VIRTIO",
        "tpm": false,
        "secureBoot": false,
        "hypervEnlightenments": false,
        "autostart": false,
        "readiness": {
            "type": "phone-home"
        }
    }
}
