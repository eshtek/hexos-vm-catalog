{
    "id": "almalinux-9",
    "name": "AlmaLinux 9",
    "description": "A community-governed enterprise Linux, binary-compatible with Red Hat Enterprise Linux, installed from the official AlmaLinux 9 GenericCloud image.",
    "icon": "_icons/almalinux.svg",
    "website": "https://almalinux.org/",
    "category": "server",
    "truenasVersion": ">=25.04.2.6",
    "provisioning": {
        "strategy": "cloud-init",
        "source": {
            "url": "https://repo.almalinux.org/almalinux/9/cloud/x86_64/images/AlmaLinux-9-GenericCloud-{version}.x86_64.qcow2",
            "version": "9.8-20260810",
            "format": "qcow2",
            "compression": "none",
            "sha256": "6bdab6376d46d42e4203ace3733efafc7c5d37c7cb443a6cc74750097002d74b",
            "releasesUrl": "https://repo.almalinux.org/almalinux/9/cloud/x86_64/images/"
        },
        "cloudInit": {
            "userDataTemplate": "linux-default"
        }
    },
    "resources": {
        "minMemoryMb": 2048,
        "recMemoryMb": 4096,
        "minVcpus": 1,
        "recVcpus": 2,
        "diskGb": 32
    },
    "guest": {
        "firmware": "UEFI",
        "diskBus": "VIRTIO",
        "nicModel": "VIRTIO",
        "tpm": false,
        "secureBoot": false,
        "hypervEnlightenments": false,
        "autostart": false,
        "readiness": {
            "type": "phone-home"
        }
    }
}
