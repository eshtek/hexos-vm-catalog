{
    "id": "debian-12",
    "name": "Debian 12 (Bookworm)",
    "description": "Debian 12 from the official cloud image, configured on first boot. This is the previous stable release, for workloads pinned to it while Trixie settles.",
    "icon": "_icons/debian.svg",
    "website": "https://www.debian.org/",
    "category": "server",
    "truenasVersion": ">=25.04.2.6",
    "requiredCapabilities": [
        "virtioSeed"
    ],
    "provisioning": {
        "strategy": "cloud-init",
        "source": {
            "url": "https://cloud.debian.org/images/cloud/bookworm/{version}/debian-12-genericcloud-amd64-{version}.qcow2",
            "version": "20261021-2638",
            "format": "qcow2",
            "compression": "none",
            "sha512": "9f181877006e8d9ca4f4554eba8729a829936f0f7d1db5e77f69b1ef0f6bc372b4d46f3dae39b10d84f9131496c2cc1d449264f26577fe934a79de5a5512a3dd",
            "releasesUrl": "https://cloud.debian.org/images/cloud/bookworm/"
        },
        "cloudInit": {
            "userDataTemplate": "linux-default"
        }
    },
    "resources": {
        "minMemoryMb": 1024,
        "recMemoryMb": 2048,
        "minVcpus": 1,
        "recVcpus": 2,
        "diskGb": 20
    },
    "guest": {
        "firmware": "UEFI",
        "diskBus": "VIRTIO",
        "nicModel": "VIRTIO",
        "tpm": false,
        "secureBoot": false,
        "hypervEnlightenments": false,
        "autostart": false,
        "readiness": {
            "type": "phone-home"
        }
    }
}
