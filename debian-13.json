{
    "id": "debian-13",
    "name": "Debian 13 (Trixie)",
    "description": "The rock-solid universal server distro, installed from the official Debian 13 \"Trixie\" cloud image and configured on first boot with your user account and SSH access.",
    "icon": "_icons/debian.svg",
    "website": "https://www.debian.org/",
    "category": "server",
    "truenasVersion": ">=25.04.2.6",
    "provisioning": {
        "strategy": "cloud-init",
        "source": {
            "url": "https://cloud.debian.org/images/cloud/trixie/{version}/debian-13-genericcloud-amd64-{version}.qcow2",
            "version": "20260826-2582",
            "format": "qcow2",
            "compression": "none",
            "sha512": "184761b0dad0f9ace02f9298050ca96ce3caa39a461a47706d47ff9698b59933918b91b40177fbd4d392f6446af8b4d18ecb94caca988169b19641606bf34003",
            "releasesUrl": "https://cloud.debian.org/images/cloud/trixie/"
        },
        "cloudInit": {
            "userDataTemplate": "linux-default"
        }
    },
    "resources": {
        "minMemoryMb": 1024,
        "recMemoryMb": 4096,
        "minVcpus": 1,
        "recVcpus": 2,
        "diskGb": 32
    },
    "guest": {
        "firmware": "UEFI",
        "diskBus": "VIRTIO",
        "nicModel": "VIRTIO",
        "tpm": false,
        "secureBoot": false,
        "hypervEnlightenments": false,
        "autostart": false,
        "readiness": {
            "type": "phone-home"
        }
    }
}
