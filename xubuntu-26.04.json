{
    "id": "xubuntu-26.04",
    "name": "Xubuntu 26.04 LTS",
    "description": "Ubuntu 26.04 LTS with the Xfce desktop, installed hands-free from Canonical's official installer. It keeps the same Ubuntu base and update schedule, paired with a lightweight, conventional desktop that runs well on modest resources.",
    "icon": "_icons/xubuntu.svg",
    "website": "https://xubuntu.org/",
    "screenshots": [
        "xubuntu-26.04/screenshots/desktop.jpg",
        "xubuntu-26.04/screenshots/favorites-menu.jpg",
        "xubuntu-26.04/screenshots/settings-menu.jpg",
        "xubuntu-26.04/screenshots/accessories-menu.jpg",
        "xubuntu-26.04/screenshots/multimedia-menu.jpg"
    ],
    "category": "desktop",
    "truenasVersion": ">=25.04.2.6",
    "internal": true,
    "apps": {
        "runtime": "flatpak"
    },
    "provisioning": {
        "strategy": "installer-iso",
        "source": {
            "url": "https://cdimage.ubuntu.com/xubuntu/releases/{version}/release/xubuntu-{version}-desktop-amd64.iso",
            "version": "26.04.1",
            "sha256": "0cd5160f72ae6b7a26be7a29248b60cbd579b9e6aa8fbd274e95264da0ade43d",
            "releasesUrl": "https://cdimage.ubuntu.com/xubuntu/releases/"
        },
        "seed": {
            "template": "ubuntu-desktop-autoinstall"
        }
    },
    "resources": {
        "minMemoryMb": 2048,
        "recMemoryMb": 4096,
        "minVcpus": 2,
        "recVcpus": 4,
        "maxUsefulVcpus": 6,
        "diskGb": 64
    },
    "guest": {
        "firmware": "UEFI",
        "diskBus": "VIRTIO",
        "nicModel": "VIRTIO",
        "tpm": false,
        "secureBoot": false,
        "hypervEnlightenments": false,
        "autostart": false,
        "passthrough": [
            "gpu",
            "usb",
            "usb-controller"
        ],
        "readiness": {
            "type": "phone-home"
        }
    }
}
