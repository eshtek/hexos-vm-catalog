{
    "id": "ubuntu-26.04",
    "name": "Ubuntu Server 26.04 LTS",
    "description": "Ubuntu Server 26.04 LTS (Resolute Raccoon) from Canonical's official cloud image, configured on first boot with your user account and SSH access.",
    "icon": "_icons/ubuntu.svg",
    "website": "https://ubuntu.com/server",
    "category": "server",
    "truenasVersion": ">=25.04.2.6",
    "provisioning": {
        "strategy": "cloud-init",
        "source": {
            "url": "https://cloud-images.ubuntu.com/releases/26.04/{version}/ubuntu-26.04-server-cloudimg-amd64.img",
            "version": "release-20260823",
            "format": "qcow2",
            "compression": "none",
            "sha256": "8196be9d7958059cb56c6c75c80fdf6cee8a8885bc149ea791d7db1c7ef93035",
            "releasesUrl": "https://cloud-images.ubuntu.com/releases/26.04/"
        },
        "cloudInit": {
            "userDataTemplate": "linux-default"
        }
    },
    "resources": {
        "minMemoryMb": 1024,
        "recMemoryMb": 4096,
        "minVcpus": 1,
        "recVcpus": 2,
        "diskGb": 32
    },
    "guest": {
        "firmware": "UEFI",
        "diskBus": "VIRTIO",
        "nicModel": "VIRTIO",
        "tpm": false,
        "secureBoot": false,
        "hypervEnlightenments": false,
        "autostart": false,
        "readiness": {
            "type": "phone-home"
        }
    }
}
