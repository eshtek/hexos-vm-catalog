{
    "id": "ubuntu-desktop-26.04",
    "name": "Ubuntu Desktop 26.04 LTS",
    "description": "The most widely used Linux desktop and a popular alternative to Windows. Ubuntu 26.04 LTS installs hands-free from Canonical's official installer.",
    "icon": "_icons/ubuntu.svg",
    "website": "https://ubuntu.com/desktop",
    "screenshots": [
        "ubuntu-desktop-26.04/screenshots/desktop.jpg",
        "ubuntu-desktop-26.04/screenshots/desktop-dark.jpg",
        "ubuntu-desktop-26.04/screenshots/applications-menu.jpg",
        "ubuntu-desktop-26.04/screenshots/quick-menu.jpg"
    ],
    "category": "desktop",
    "truenasVersion": ">=25.04.2.6",
    "apps": {
        "runtime": "flatpak"
    },
    "provisioning": {
        "strategy": "installer-iso",
        "source": {
            "url": "https://releases.ubuntu.com/{version}/ubuntu-{version}-desktop-amd64.iso",
            "version": "26.04.1",
            "sha256": "601e30fbf5d97759367c632e2c33630665039b7e2158fd068403da3ccf1bda1f",
            "releasesUrl": "https://releases.ubuntu.com/26.04/"
        },
        "seed": {
            "template": "ubuntu-desktop-autoinstall"
        }
    },
    "resources": {
        "minMemoryMb": 4096,
        "recMemoryMb": 8192,
        "minVcpus": 2,
        "recVcpus": 4,
        "maxUsefulVcpus": 6,
        "diskGb": 64
    },
    "guest": {
        "firmware": "UEFI",
        "diskBus": "VIRTIO",
        "nicModel": "VIRTIO",
        "tpm": false,
        "secureBoot": false,
        "hypervEnlightenments": false,
        "autostart": false,
        "passthrough": [
            "gpu",
            "usb",
            "usb-controller"
        ],
        "readiness": {
            "type": "phone-home"
        }
    }
}
