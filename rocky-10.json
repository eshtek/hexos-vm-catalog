{
    "id": "rocky-10",
    "name": "Rocky Linux 10",
    "description": "Rocky Linux 10 from the official GenericCloud image, the newest enterprise-grade release and binary-compatible with Red Hat Enterprise Linux. Requires a CPU supporting x86-64-v3 (roughly Intel Haswell / AMD Excavator or newer).",
    "icon": "_icons/rocky.svg",
    "website": "https://rockylinux.org/",
    "category": "server",
    "truenasVersion": ">=25.04.2.6",
    "cpuFeatures": ["avx", "avx2", "bmi1", "bmi2", "f16c", "fma", "abm", "movbe", "xsave"],
    "provisioning": {
        "strategy": "cloud-init",
        "source": {
            "url": "https://dl.rockylinux.org/pub/rocky/10/images/x86_64/Rocky-10-GenericCloud-Base-{version}.x86_64.qcow2",
            "version": "10.2-20260525.0",
            "format": "qcow2",
            "compression": "none",
            "sha256": "9fc9e9ff16888bb68ac39b0392e25c9c92684d50c85f1cce6ab549363bbc4b48",
            "releasesUrl": "https://dl.rockylinux.org/pub/rocky/10/images/x86_64/"
        },
        "cloudInit": {
            "userDataTemplate": "linux-default"
        }
    },
    "resources": {
        "minMemoryMb": 2048,
        "recMemoryMb": 4096,
        "minVcpus": 1,
        "recVcpus": 2,
        "diskGb": 32
    },
    "guest": {
        "firmware": "UEFI",
        "diskBus": "VIRTIO",
        "nicModel": "VIRTIO",
        "tpm": false,
        "secureBoot": false,
        "hypervEnlightenments": false,
        "autostart": false,
        "readiness": {
            "type": "phone-home"
        }
    }
}
