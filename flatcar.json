{
    "id": "flatcar",
    "name": "Flatcar Container Linux",
    "description": "Flatcar Container Linux from the official stable channel, an immutable and automatically-updating container host in the CoreOS lineage. Configured at first boot from an Ignition document.",
    "icon": "_icons/flatcar.svg",
    "website": "https://www.flatcar.org/",
    "category": "server",
    "truenasVersion": ">=25.04.2.6",
    "provisioning": {
        "strategy": "machine-config",
        "source": {
            "url": "https://stable.release.flatcar-linux.net/amd64-usr/{version}/flatcar_production_openstack_image.img",
            "version": "4757.2.2",
            "format": "qcow2",
            "compression": "none",
            "sha512": "b7e937c19d43ac5626604273a9baf222b1c2d225db645b278ac2670cef640a8e66cdb6acfd65ed53c8bc5df4344575a687d3a1a5ae4e5602d5ccc95924067ada",
            "releasesUrl": "https://stable.release.flatcar-linux.net/amd64-usr/"
        },
        "machineConfig": {
            "template": "flatcar-ignition",
            "delivery": "config-drive"
        }
    },
    "resources": {
        "minMemoryMb": 2048,
        "recMemoryMb": 4096,
        "minVcpus": 2,
        "recVcpus": 2,
        "diskGb": 32
    },
    "guest": {
        "firmware": "UEFI",
        "diskBus": "VIRTIO",
        "nicModel": "VIRTIO",
        "tpm": false,
        "secureBoot": false,
        "hypervEnlightenments": false,
        "autostart": true,
        "readiness": {
            "type": "phone-home"
        }
    }
}
