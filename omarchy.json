{
    "id": "omarchy",
    "name": "Omarchy 4",
    "description": "A keyboard-driven, developer-focused desktop that updates continuously. DHH's opinionated Arch Linux build with the Hyprland tiling compositor installs hands-free from the official ISO. Attach a GPU for a smooth Wayland session.",
    "icon": "_icons/omarchy.svg",
    "website": "https://omarchy.org/",
    "screenshots": [
        "omarchy/screenshots/quattro.jpg",
        "omarchy/screenshots/theme-gruvbox.jpg",
        "omarchy/screenshots/theme-nord.jpg",
        "omarchy/screenshots/theme-ristretto.jpg"
    ],
    "category": "desktop",
    "truenasVersion": ">=25.04.2.6",
    "apps": {
        "runtime": "flatpak"
    },
    "provisioning": {
        "strategy": "installer-iso",
        "source": {
            "url": "https://iso.omarchy.org/omarchy-{version}.iso",
            "version": "4.0.0",
            "sha256": "9224fab3720560f771969a99a499e5f7e0f8e2d6a0681d872d52f05fb5003da4",
            "releasesUrl": "https://github.com/basecamp/omarchy/releases"
        },
        "seed": {
            "template": "omarchy-autoinstall"
        }
    },
    "resources": {
        "minMemoryMb": 4096,
        "recMemoryMb": 8192,
        "minVcpus": 2,
        "recVcpus": 4,
        "maxUsefulVcpus": 6,
        "diskGb": 64
    },
    "guest": {
        "firmware": "UEFI",
        "diskBus": "VIRTIO",
        "nicModel": "VIRTIO",
        "tpm": false,
        "secureBoot": false,
        "hypervEnlightenments": false,
        "autostart": false,
        "passthrough": [
            "gpu",
            "usb",
            "usb-controller"
        ],
        "readiness": {
            "type": "phone-home"
        }
    }
}
