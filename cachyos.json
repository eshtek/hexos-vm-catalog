{
    "id": "cachyos",
    "name": "CachyOS",
    "description": "The performance-tuned Arch Linux with the KDE Plasma desktop, installed hands-free by CachyOS's own headless installer. It ships optimized kernels and CPU-tuned packages on a rolling update schedule. Attach a GPU for gaming workloads.",
    "icon": "_icons/cachyos.svg",
    "website": "https://cachyos.org/",
    "screenshots": [
        "cachyos/screenshots/desktop.jpg",
        "cachyos/screenshots/desktop-kde.jpg",
        "cachyos/screenshots/theme-nord.jpg",
        "cachyos/screenshots/desktop-xfce.jpg"
    ],
    "category": "desktop",
    "truenasVersion": ">=25.04.2.6",
    "apps": {
        "runtime": "flatpak"
    },
    "provisioning": {
        "strategy": "installer-iso",
        "source": {
            "url": "https://build.cachyos.org/ISO/desktop/{version}/cachyos-desktop-linux-{version}.iso",
            "version": "260809",
            "sha256": "959f6577f45e25ee9fd8c220fd221b08e4ea79412c7315c0f922dd6d86d5e33c",
            "releasesUrl": "https://build.cachyos.org/ISO/desktop/"
        },
        "seed": {
            "template": "cachyos-headless"
        }
    },
    "resources": {
        "minMemoryMb": 4096,
        "recMemoryMb": 8192,
        "minVcpus": 2,
        "recVcpus": 4,
        "maxUsefulVcpus": 6,
        "diskGb": 64
    },
    "guest": {
        "firmware": "UEFI",
        "diskBus": "VIRTIO",
        "nicModel": "VIRTIO",
        "tpm": false,
        "secureBoot": false,
        "hypervEnlightenments": false,
        "autostart": false,
        "passthrough": [
            "gpu",
            "usb",
            "usb-controller"
        ],
        "readiness": {
            "type": "phone-home"
        }
    }
}
