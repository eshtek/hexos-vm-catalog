{
    "id": "opensuse-leap-16",
    "name": "openSUSE Leap 16.1",
    "description": "openSUSE Leap 16.1, installed hands-free from the official offline installer. This is a fixed-release desktop and workstation distribution built from the same sources as SUSE Linux Enterprise, with 24 months of updates per release.",
    "icon": "_icons/opensuse.svg",
    "website": "https://get.opensuse.org/leap/",
    "screenshots": [
        "opensuse-leap-16/screenshots/desktop.jpg",
        "opensuse-leap-16/screenshots/desktop-dark.jpg",
        "opensuse-leap-16/screenshots/desktop-gnome.jpg",
        "opensuse-leap-16/screenshots/desktop-alt.jpg"
    ],
    "category": "desktop",
    "truenasVersion": ">=25.04.2.6",
    "cpuFeatures": [
        "cx16",
        "lahf_lm",
        "popcnt",
        "sse4_1",
        "sse4_2",
        "ssse3"
    ],
    "apps": {
        "runtime": "flatpak"
    },
    "provisioning": {
        "strategy": "installer-iso",
        "source": {
            "url": "https://download.opensuse.org/distribution/leap/16.1/offline/Leap-16.1-offline-installer-x86_64-Build60.2.install.iso",
            "version": "16.1-Build60.2",
            "sha512": "c95738ba232a36eb31dfdf3e5f663beb672232410894ab04b1bfe0c7a803a622868a90fe631fc6c89418eca9ad181979b8817a52fdec3c203a9a5b7b997ba051",
            "releasesUrl": "https://download.opensuse.org/distribution/leap/16.1/offline/"
        },
        "seed": {
            "template": "opensuse-agama-profile"
        }
    },
    "resources": {
        "minMemoryMb": 4096,
        "recMemoryMb": 8192,
        "minVcpus": 2,
        "recVcpus": 4,
        "maxUsefulVcpus": 6,
        "diskGb": 64
    },
    "guest": {
        "firmware": "UEFI",
        "diskBus": "VIRTIO",
        "nicModel": "VIRTIO",
        "tpm": false,
        "secureBoot": false,
        "hypervEnlightenments": false,
        "autostart": false,
        "passthrough": [
            "gpu",
            "usb",
            "usb-controller"
        ],
        "readiness": {
            "type": "phone-home"
        }
    }
}
