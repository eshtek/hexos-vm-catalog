{
    "id": "haos",
    "name": "Home Assistant OS",
    "description": "The official Home Assistant appliance OS, a full home automation platform with add-on support, managed updates, and backups.",
    "icon": "_icons/haos.svg",
    "website": "https://www.home-assistant.io/",
    "screenshots": [
        "home-assistant-os/screenshots/dashboard.jpg"
    ],
    "category": "appliance",
    "truenasVersion": ">=25.04.2.6",
    "provisioning": {
        "strategy": "image",
        "source": {
            "url": "https://github.com/home-assistant/operating-system/releases/download/{version}/haos_ova-{version}.qcow2.xz",
            "version": "18.2",
            "format": "qcow2",
            "compression": "xz",
            "sha256": "254e53f354df0739e3afc09be5431a07df53f0df6b703885404f665c454f254e",
            "releasesUrl": "https://github.com/home-assistant/operating-system/releases"
        }
    },
    "resources": {
        "minMemoryMb": 2048,
        "recMemoryMb": 4096,
        "minVcpus": 1,
        "recVcpus": 2,
        "diskGb": 32
    },
    "guest": {
        "firmware": "UEFI",
        "diskBus": "VIRTIO",
        "nicModel": "VIRTIO",
        "tpm": false,
        "secureBoot": false,
        "hypervEnlightenments": false,
        "passthrough": [
            "usb",
            "usb-controller"
        ],
        "readiness": {
            "type": "mdns",
            "hostname": "homeassistant.local",
            "port": 8123
        },
        "postInstallUrl": "http://{ip}:8123"
    }
}
