{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // TypeScript 7 (the runner-global tsc on CI) no longer auto-includes
    // node_modules/@types; without this field every node:* import and the Bun
    // global fail to resolve. @types/bun pulls in @types/node transitively.
    "types": ["bun"]
  },
  // The hook scripts in each blueprint's folder are typechecked against the context mirror
  // in this directory, so a script that drifts from the platform's contract
  // fails CI here rather than at run time on a user's box.
  "include": [".", "../plex-server", "../home-assistant-os"]
}
